# Welcher Zugang standardmäßig benutzt wird:
# claude_token | anthropic_api | openrouter | openai | mock
KCTEAM_PROVIDER=claude_token

# --- Zugangsdaten: nur den benötigten ausfüllen ---
# Claude-Abo: im Terminal `claude setup-token` ausführen und den Token hier eintragen
CLAUDE_CODE_OAUTH_TOKEN=
# Claude API
ANTHROPIC_API_KEY=
# OpenRouter
OPENROUTER_API_KEY=
# OpenAI / GPT-Codex
OPENAI_API_KEY=

# --- Datenbank ---
# STUFE 1 (Test, ein Kind, Karo-MVP mit SQLite):
#   Das Team arbeitet im lokalen Postgres-Container und schreibt danach eine SQLite-Kopie
#   in Karos Volume. Karo liest sie mit: ATTACH DATABASE '/data/curriculum.db' AS cur;
DATABASE_URL=postgresql://karo:karo@postgres:5432/karo
KARO_SQLITE_EXPORT=true
# Volume, das Karo unter /data einbindet (docker volume ls) – leer = KARO_VOLUME
KARO_EXPORT_VOLUME=
KARO_SQLITE_PATH=/karo-export/curriculum.db
# Port der Datenbank auf deinem Rechner (nur für Zugriff von außen, z. B. uv/psql). 5432 belegt? -> 5433
POSTGRES_HOST_PORT=5432

# STUFE 2 (Produkt): Karo und Team nutzen DIESELBE Postgres-Datenbank in der EU. Dann:
#   KARO_SQLITE_EXPORT=false  und  docker compose run --rm --no-deps kcteam   (ohne lokalen Postgres)
# Supabase – Session-Pooler (Port 5432!), NICHT den Transaktions-Pooler (6543):
# DATABASE_URL=postgresql://postgres.<projekt>:<passwort>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres?sslmode=require
# Neon – direkte Verbindung (Adresse OHNE "-pooler"):
# DATABASE_URL=postgresql://<user>:<passwort>@ep-<name>.eu-central-1.aws.neon.tech/<db>?sslmode=require

# Passwörter der Datenbank-Rollen für Karos Backend (leer = Rolle ohne Login)
# karo_reader: Inhalte lesen (inkl. Lösungen)
KARO_READER_PASSWORD=
# karo_app: Diagnose durchführen (ohne Lösungen)
KARO_APP_PASSWORD=
# karo_reviewer: Freitext bewerten, Daten nach Frist löschen
KARO_REVIEWER_PASSWORD=

# --- Curriculum-Service (HTTP) für Karo ---
# docker compose --profile agent up -d   startet API (127.0.0.1:8088) und Agent
KCTEAM_API_HOST_PORT=8088
# Prozesse der API (mehr = mehr gleichzeitige Anfragen; ~1 pro CPU-Kern)
KCTEAM_API_WORKERS=2
# Webhooks an Abnehmer (Karo braucht sie nicht)
KCTEAM_WEBHOOKS=true
# Wie oft ein Abnehmer eine Lektion verwerfen darf, bevor ein Mensch sie ansieht
KCTEAM_MAX_CLIENT_REJECTS=2

# --- Datenbank-Browser (nur lesen) ---
# docker compose --profile admin up -d   ->  http://127.0.0.1:8090  (Benutzer admin)
ADMIN_PASSWORD=
ADMIN_HOST_PORT=8090
# Karos SQLite-Datei im Karo-Volume
KARO_DB_PATH=/karo/karo.db

# --- Volumes ---
# Name des Docker-Volumes von Karo (docker volume ls). Karo aus dem Ordner "karo" -> karo_karo-data
KARO_VOLUME=karo_karo-data
KARO_SPEC_PATH=/karo
KCTEAM_EXPORT_DIR=/data/export

# --- Tests und zerstörerische Operationen -----------------------------------
# Tests laufen nur gegen eine eigene Datenbank, deren Name auf "_test" endet.
# Alles andere lehnt pytest vor dem ersten Test ab (kcteam/dbsafety.py).
# TEST_DATABASE_URL=postgresql://karo:karo@127.0.0.1:5434/karo_curriculum_test
# APP_ENV=test
# Ohne diesen Schalter läuft keine zerstörerische Operation. Bewusst setzen,
# nie dauerhaft in .env stehen lassen:
# ALLOW_DESTRUCTIVE_DB_RESET=YES
# Eigener Port für die Testdatenbank (Standard 5434):
# POSTGRES_TEST_HOST_PORT=5434

# Tageskontingent an Modellaufrufen. 0 = keine Grenze — und genau so ist an
# einem Tag das ganze Abo in 176 Fehlaufrufe gelaufen.
#
# Grundlage: `kcteam kosten`. Themen, die wirklich eine Lektion geliefert
# haben, brauchten 3 bis 10 Aufrufe. 5 Familien mal 5 Themen
# (KARO_FAMILY_DAILY_TOPICS in Karo) sind 25 Themen am Tag, also rund 250 —
# plus Reserve fuers Neuschreiben nach Befunden.
KCTEAM_DAILY_AGENT_CALLS=400
